{
  "productName": "GlassView",
  "version": "0.2.0",
  "identifier": "dev.glassview.app",

  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },

  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GlassView AI",
        "width": 900,
        "height": 650,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "shadow": false,
        "fullscreen": false,
        "visible": true,
        "backgroundColor": "#00000000"
      },
      {
        "label": "snip-overlay",
        "title": "Snip Overlay",
        "width": 800,
        "height": 600,
        "transparent": false,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "fullscreen": true,
        "shadow": false,
        "alwaysOnTop": true,
        "backgroundColor": "#000000"
      }
    ]
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
